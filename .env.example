# Copy to .env.local and fill with real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the client. Used by service-role infra (e.g. catalog writes).
SUPABASE_SERVICE_ROLE_KEY=

# Optional and server-only. Enables real coach video recommendations; without it, manual YouTube links remain available.
YOUTUBE_API_KEY=
